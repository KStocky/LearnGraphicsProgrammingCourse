-lgp::framework::Status Renderer::Update(lgp::framework::UpdateContext const &)
+void Renderer::ApplyInteractiveControls(lgp::framework::UpdateContext const &context)
+{
+    lgp::framework::InputState const &input = context.input;
+    gpu::DebugView const previousView = interactiveDebugView_;
+    bool const previousStabilization = interactiveStabilization_;
+    bool const previousBlend = interactiveBlend_;
+    bool const previousShadows = interactiveShadows_;
+
+    if (input.WasKeyPressed('V'))
+    {
+        interactiveDebugView_ =
+            static_cast<gpu::DebugView>((static_cast<std::uint32_t>(interactiveDebugView_) + 1U) % 4U);
+    }
+    if (input.WasKeyPressed('N'))
+    {
+        interactiveDebugView_ = gpu::DebugView::Shaded;
+    }
+    if (input.WasKeyPressed('C'))
+    {
+        interactiveDebugView_ = gpu::DebugView::CascadeColor;
+    }
+    if (input.WasKeyPressed('S'))
+    {
+        interactiveStabilization_ = !interactiveStabilization_;
+    }
+    if (input.WasKeyPressed('B'))
+    {
+        interactiveBlend_ = !interactiveBlend_;
+    }
+    if (input.WasKeyPressed('H'))
+    {
+        interactiveShadows_ = !interactiveShadows_;
+    }
+
+    if (interactiveDebugView_ != previousView || interactiveStabilization_ != previousStabilization ||
+        interactiveBlend_ != previousBlend || interactiveShadows_ != previousShadows)
+    {
+        std::printf("[Ch24] view=%s  stabilization=%s  blend=%s  shadows=%s\n", DebugViewName(interactiveDebugView_),
+                    interactiveStabilization_ ? "on" : "off", interactiveBlend_ ? "on" : "off",
+                    interactiveShadows_ ? "on" : "off");
+        std::fflush(stdout);
+    }
+}
+
+lgp::framework::Status Renderer::Update(lgp::framework::UpdateContext const &context)
 {
+    if (!headless_)
+    {
+        ApplyInteractiveControls(context);
+    }
     return {};
 }
 
