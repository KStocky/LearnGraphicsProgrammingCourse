+[[nodiscard]] std::string DescribeAllocationDiagnostics(
+    std::vector<transient_allocation::AllocationDiagnostic> const &diagnostics)
+{
+    std::string message{};
+    for (transient_allocation::AllocationDiagnostic const &diagnostic : diagnostics)
+    {
+        if (!message.empty())
+        {
+            message += '\n';
+        }
+        message += diagnostic.message;
+    }
+    return message;
+}
+
+[[nodiscard]] ch08::frame_graph::ResourceLifetime const *FindLifetime(
+    ch08::frame_graph::CompiledPassGraph const &graph, ch08::frame_graph::TextureResourceId resourceId) noexcept
+{
+    auto const lifetime =
+        std::ranges::find(graph.resourceLifetimes, resourceId, &ch08::frame_graph::ResourceLifetime::resourceId);
+    return lifetime == graph.resourceLifetimes.end() ? nullptr : &*lifetime;
+}
