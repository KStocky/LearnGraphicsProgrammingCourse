+struct ClippedSegment
+{
+    bool intersectsFrustum;
+    float enterDistance;
+    float exitDistance;
+    float3 enterPosition;
+    float3 exitPosition;
+    uint enterLimit;
+    uint exitLimit;
+    uint rejectionLimit;
