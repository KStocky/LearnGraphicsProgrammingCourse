+            &defaultHeap, D3D12_HEAP_FLAG_NONE, &textureDescription, D3D12_BARRIER_LAYOUT_COPY_DEST, nullptr, nullptr,
+            0U, nullptr, IID_PPV_ARGS(materialTextures[textureIndex].ReleaseAndGetAddressOf()));
+        if (FAILED(textureResult))
