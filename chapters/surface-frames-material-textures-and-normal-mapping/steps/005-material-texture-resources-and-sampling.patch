+lgp::framework::Status Renderer::Impl::CreateMaterialTextures()
+{
+    TexturePixels const pixels = GenerateMaterialTextures();
+    std::array<std::vector<std::uint8_t> const *, 3U> const sources{
+        &pixels.baseColor,
+        &pixels.packedMaterial,
+        &pixels.normal,
