     payload.hitKind = HitKind();
     payload.missShaderIndex = InvalidIndex;
+    payload.tHit = RayTCurrent();
+    payload.barycentricB1 = attributes.barycentrics.x;
+    payload.barycentricB2 = attributes.barycentrics.y;
 }

