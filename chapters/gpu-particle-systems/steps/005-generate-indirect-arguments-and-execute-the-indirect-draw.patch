-// Chapter 34 checkpoint 4: stable scan-and-scatter compaction of the live set.
+// Chapter 34 checkpoint 5: indirect argument generation and the ExecuteIndirect draw.
 //
-// CompactCS flags each live particle, runs the same group-wide inclusive scan emission used, and scatters each
-// live index to its exclusive-prefix position, producing a dense, index-ordered list of live slots and their
-// identities plus the live and emitted counters. The scatter is clamped to the output capacity and an
-// out-of-bounds sentinel guards the boundary, so an over-full frame is bounded rather than corrupting. Indirect
-// arguments, the indirect draw and the checksum arrive in later checkpoints, so the compacted list is produced but
-// not yet consumed by a draw.
+// IndirectArgsCS reads the emitted count the compaction produced and writes the D3D12_DRAW_ARGUMENTS a command
+// signature reads, plus the one-or-zero command count. The host then places the explicit unordered-access to
+// indirect-argument barrier that makes the compute write visible to ExecuteIndirect, transitions the final state
+// slot and the compacted list to vertex-shader reads, and issues a single ExecuteIndirect that draws one instanced
+// quad per live particle straight from GPU-produced arguments, with no CPU readback of the count. The picture
+// finally appears. The checksum evidence pass arrives in the final checkpoint.
 
 #define LGP_PARTICLE_THREAD_GROUP_SIZE 256
 
@@ -367,6 +367,19 @@ void CompactCS(uint3 dispatchThreadId : SV_DispatchThreadID, uint groupIndex : S
     }
 }
 
+[numthreads(1, 1, 1)]
+void IndirectArgsCS()
+{
+    uint instanceCount = min(gCounters[kCounterEmitted], gDrawCapacity);
+
+    gIndirectArgs.Store(0u, gVertexCountPerParticle);
+    gIndirectArgs.Store(4u, instanceCount);
+    gIndirectArgs.Store(8u, 0u);
+    gIndirectArgs.Store(12u, 0u);
+
+    gIndirectCount[0] = (instanceCount > 0u) ? 1u : 0u;
+}
