--- /dev/null
+++ b/chapters/radiometry-light-units-and-brdfs/Starter/DirectLighting.hlsl
@@ -0,0 +1,19 @@
+// Step 1: keep the units visible before introducing a BRDF.
+
+static const float MinimumDistanceSquared = 1.0e-4;
+
+float DirectionalNormalIlluminance(float illuminanceLux)
+{
+    return max(illuminanceLux, 0.0);
+}
+
+float PointNormalIlluminance(float luminousIntensityCandela, float3 offsetToLight)
+{
+    float distanceSquared = max(dot(offsetToLight, offsetToLight), MinimumDistanceSquared);
+    return max(luminousIntensityCandela, 0.0) / distanceSquared;
+}
+
+float3 TintIlluminance(float illuminanceLux, float3 lightColor)
+{
+    return illuminanceLux * max(lightColor, 0.0);
+}
