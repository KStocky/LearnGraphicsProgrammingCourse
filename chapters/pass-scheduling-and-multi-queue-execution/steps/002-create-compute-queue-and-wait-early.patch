+lgp::framework::Status Renderer::CreateFrameCommandObjects()
+{
+    frameSlots_.resize(deviceResources_->back_buffer_count());
+    for (FrameSlotTextures &slot : frameSlots_)
+    {
+        HRESULT result = deviceResources_->device()->CreateCommandAllocator(
+            D3D12_COMMAND_LIST_TYPE_COMPUTE, IID_PPV_ARGS(slot.computeAllocator.ReleaseAndGetAddressOf()));
+        if (FAILED(result))
+        {
+            return std::unexpected(lgp::framework::MakeHResultError(
+                "ID3D12Device::CreateCommandAllocator", result, "Failed to create a per-slot compute allocator."));
+        }
+        result = deviceResources_->device()->CreateCommandList(
+            0U, D3D12_COMMAND_LIST_TYPE_COMPUTE, slot.computeAllocator.Get(), nullptr,
+            IID_PPV_ARGS(slot.computeList.ReleaseAndGetAddressOf()));
+        if (FAILED(result))
+        {
+            return std::unexpected(lgp::framework::MakeHResultError(
+                "ID3D12Device::CreateCommandList", result, "Failed to create a per-slot compute command list."));
+        }
+        result = slot.computeList->Close();
+        if (FAILED(result))
+        {
+            return std::unexpected(lgp::framework::MakeHResultError(
+                "ID3D12GraphicsCommandList::Close", result, "Failed to close a new compute command list."));
+        }
+    }
+    return {};
 }
 
