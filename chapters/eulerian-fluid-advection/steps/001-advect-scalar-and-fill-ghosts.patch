+        x = clamp(x, 0, nx - 1);
+        y = clamp(y, 0, ny - 1);
+        if (boundaryMode == 0u &&
+            ((kind == 1u && (x == 0 || x == nx - 1)) ||
+             (kind == 2u && (y == 0 || y == ny - 1))))
+            return 0.0;
+    }
+    uint address = uint(y + 1) * uint(nx + 2) + uint(x + 1);
+    if (kind == 0u) return sourceScalar[address];
+    if (kind == 1u) return sourceU[address];
+    if (kind == 2u) return sourceV[address];
+    return prediction[address];
