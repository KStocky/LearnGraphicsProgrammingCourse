+            continue;
+        }
+        if (hasOccupied == 0u)
+        {
+            hasOccupied = 1u;
+            lowest = scan;
+        }
+        highest = scan;
+        ++occupied;
+    }
+    meter.occupiedBinCount = occupied;
+    meter.lowestOccupiedBin = lowest;
+    meter.highestOccupiedBin = highest;
