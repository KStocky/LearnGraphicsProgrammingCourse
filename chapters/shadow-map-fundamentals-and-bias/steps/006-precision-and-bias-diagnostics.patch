+float RasterSlope(float3 normal, float3 lightDirection)
+{
+    float cosine = max(abs(dot(normal, lightDirection)), 1.0e-4);
+    return min(sqrt(max(1.0 - (cosine * cosine), 0.0)) / cosine, 1.0e4);
+}
