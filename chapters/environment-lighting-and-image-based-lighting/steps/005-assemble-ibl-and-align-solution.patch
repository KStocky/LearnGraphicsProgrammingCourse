     output.lutB = lut.y;
     output.lutRoughness = lutRoughness;
     output.lutNDotView = lutNDotView;
+    output.shadedSpecularR = shadedSpecular.r;
+    output.shadedSpecularG = shadedSpecular.g;
+    output.shadedSpecularB = shadedSpecular.b;
