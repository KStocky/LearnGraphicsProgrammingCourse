-// Chapter 27 checkpoint 1: diffuse environment irradiance.
+// Chapter 27 checkpoint 2: V=N isotropic-GGX environment prefiltering.
 //
-// The deterministic lat-long environment is integrated over every texel with
-// that row's exact solid angle and the clamped cosine N.wi. The result stores
-// irradiance E; the Lambertian albedo/pi factor remains a separate shading
-// operation. Specular lighting still uses the Starter's sharp lookup.
+// Diffuse stores irradiance E and applies albedo/pi only in shading. The new
+// specular prefilter uses the shared true base-2 Hammersley sequence and
+// isotropic GGX NDF sampling (not VNDF) with the distant-environment V=N
+// approximation. This checkpoint samples mip zero so proposal behavior is
+// isolated before PDF-driven footprint selection is introduced.
 #include "../Common/EnvironmentLightingShared.hlsli"
 
 float3 IntegrateIrradiance(float3 normal)
@@ -23,6 +24,26 @@ float3 IntegrateIrradiance(float3 normal)
     return irradiance;
 }
 
+void IntegratePrefilter(float3 normal, out float3 baseResult, out uint accepted)
+{
+    float3 accumulation = 0.0f;
+    float weight = 0.0f;
+    accepted = 0u;
+    for (uint sampleIndex = 0u; sampleIndex < PrefilterSampleCount; ++sampleIndex)
+    {
+        GgxSample sample =
+            SampleGgxReflection(normal, normal, Roughness, Hammersley(sampleIndex, PrefilterSampleCount));
+        if (sample.nDotL <= 0.0f || sample.lightPdf <= 0.0f)
+        {
+            continue;
+        }
+        accumulation += SampleEnvironment(sample.lightDirection, 0.0f) * sample.nDotL;
+        weight += sample.nDotL;
+        ++accepted;
+    }
+    baseResult = accumulation / weight;
+}
