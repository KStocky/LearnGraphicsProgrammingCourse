-// Chapter 27 Starter: honest bounded environment-lighting baseline.
+// Chapter 27 checkpoint 1: diffuse environment irradiance.
 //
-// The environment is deterministic analytic data stored in a generated
-// lat-long texture. This baseline deliberately does not claim to integrate
-// irradiance or prefilter a BRDF: diffuse uses one normal-direction lookup and
-// specular uses one sharp reflection lookup. The Solution adds the complete
-// paired lab while preserving these values for direct comparison.
+// The deterministic lat-long environment is integrated over every texel with
+// that row's exact solid angle and the clamped cosine N.wi. The result stores
+// irradiance E; the Lambertian albedo/pi factor remains a separate shading
+// operation. Specular lighting still uses the Starter's sharp lookup.
 #include "../Common/EnvironmentLightingShared.hlsli"
 
+float3 IntegrateIrradiance(float3 normal)
+{
+    float3 irradiance = 0.0f;
+    for (uint row = 0u; row < EnvironmentHeight; ++row)
+    {
+        float solidAngle = LatLongTexelSolidAngle(row);
+        for (uint column = 0u; column < EnvironmentWidth; ++column)
+        {
+            float3 direction = LatLongUvToDirection(float2(((float)column + 0.5f) / (float)EnvironmentWidth,
+                                                           ((float)row + 0.5f) / (float)EnvironmentHeight));
+            float cosine = max(0.0f, dot(normal, direction));
+            irradiance += EnvironmentTexture.Load(int3(column, row, 0)).rgb * (cosine * solidAngle);
+        }
+    }
+    return irradiance;
+}
