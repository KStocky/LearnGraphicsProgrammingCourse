-// Chapter 27 checkpoint 2: V=N isotropic-GGX environment prefiltering.
+// Chapter 27 checkpoint 3: exact-Smith split-sum integration.
 //
-// Diffuse stores irradiance E and applies albedo/pi only in shading. The new
-// specular prefilter uses the shared true base-2 Hammersley sequence and
-// isotropic GGX NDF sampling (not VNDF) with the distant-environment V=N
-// approximation. This checkpoint samples mip zero so proposal behavior is
-// isolated before PDF-driven footprint selection is introduced.
+// Diffuse irradiance and the V=N isotropic-GGX base-level prefilter are now
+// accompanied by split-sum A/B data for F0*A+B. The integral uses exact
+// uncorrelated Smith G1(V)G1(L) and Schlick Fresnel for a single-scatter GGX
+// BRDF under a white environment; it deliberately does not compensate the
+// energy lost to multiple scattering at high roughness.
 #include "../Common/EnvironmentLightingShared.hlsli"
 
 float3 IntegrateIrradiance(float3 normal)
@@ -44,6 +44,28 @@ void IntegratePrefilter(float3 normal, out float3 baseResult, out uint accepted)
     baseResult = accumulation / weight;
 }
 
+float2 IntegrateSplitSum(float nDotView, float roughness)
+{
+    float3 normal = float3(0.0f, 1.0f, 0.0f);
+    float3 viewDirection = float3(sqrt(max(0.0f, 1.0f - nDotView * nDotView)), nDotView, 0.0f);
+    float gView = SmithG1(nDotView, roughness);
+    float2 result = 0.0f;
+    for (uint sampleIndex = 0u; sampleIndex < SplitSumSampleCount; ++sampleIndex)
+    {
+        GgxSample sample =
+            SampleGgxReflection(normal, viewDirection, roughness, Hammersley(sampleIndex, SplitSumSampleCount));
+        if (sample.nDotL <= 0.0f || sample.nDotH <= 0.0f || sample.vDotH <= 0.0f)
+        {
+            continue;
+        }
+        float visibility = (gView * SmithG1(sample.nDotL, roughness) * sample.vDotH) / (sample.nDotH * nDotView);
+        float fresnelComplement = pow(1.0f - sample.vDotH, 5.0f);
+        result.x += (1.0f - fresnelComplement) * visibility;
+        result.y += fresnelComplement * visibility;
+    }
+    return result / (float)SplitSumSampleCount;
+}
