{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 1,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LGP_WARNINGS_AS_ERRORS": "ON",
        "LGP_BUILD_TESTS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC x64",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "clang-cl",
      "displayName": "clang-cl x64",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER_TYPE": "MSVC",
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo"
      }
    },
    {
      "name": "visual-studio",
      "displayName": "Visual Studio 2026 x64",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-relwithdebinfo",
      "configurePreset": "msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "clang-cl-debug",
      "configurePreset": "clang-cl",
      "configuration": "Debug"
    },
    {
      "name": "clang-cl-relwithdebinfo",
      "configurePreset": "clang-cl",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "visual-studio-debug",
      "configurePreset": "visual-studio",
      "configuration": "Debug"
    }
  ]
}
